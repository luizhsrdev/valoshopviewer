{
  "expo": {
    "name": "Minha Loja",
    "slug": "minha-loja",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "minhaloja",
    "userInterfaceStyle": "dark",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07080A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.luiz.minhaloja"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07080A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#FF4655",
          "defaultChannel": "loja"
        }
      ],
      "expo-background-task",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d92bd695-e76d-4c1d-8618-91cd5c84fd89"
      }
    },
    "owner": "luizhsnn",
    "updates": {
      "url": "https://u.expo.dev/d92bd695-e76d-4c1d-8618-91cd5c84fd89"
    },
    "backgroundColor": "#07080A",
    "platforms": [
      "android"
    ]
  }
}
